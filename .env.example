# Copy to ../.env (one level above manage.py). Never commit the real .env.
SECRET_KEY='change-me'
DEBUG=1
DB_ENGINE=sqlite
ALLOWED_HOSTS=localhost,127.0.0.1
# Base URL for links in email (defaults to http://localhost:8000 with DEBUG=1, else the live site).
# SITE_URL=http://localhost:8000
# Email: leave all of these unset to print emails to the console (DEBUG=1) or write them
# to ../logs/emails/ (DEBUG=0). Set one of EMAIL_URL or EMAIL_HOST to send for real.
# EMAIL_URL=smtp://user:pass@smtp.provider.com:587/     # smtps:// for SSL, add ?tls=0 to disable STARTTLS
# EMAIL_HOST=smtp.provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# Production only:
# DB_NAME=storefront
# DB_USER=storefront_app
# DB_PASSWORD=...
# DB_HOST=127.0.0.1
# AWS_STORAGE_BUCKET_NAME=inkedgraphics-storefront
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
